{
  "api": {
    "services": [
      "HandlerService",
      "LoggerService",
      "StatsService"
    ],
    "tag": "api"
  },
  "dns": {
    "queryStrategy": "UseIPv4",
    "servers": [
      "1.1.1.1",
      "1.0.0.1"
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10086,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1",
        "network": "tcp,udp"
      },
      "tag": "api"
    }
  ],
  "outbounds": [
    {
      "protocol": "wireguard",
      "settings": {
        "secretKey": "SECRET_KEY_PLACEHOLDER=",
        "address": [
          "172.16.0.2/32"
        ],
        "peers": [
          {
            "publicKey": "PUBLIC_KEY_PLACEHOLDER=",
            "allowedIPs": [
              "0.0.0.0/0"
            ],
            "endpoint": "162.159.192.1:2408",
            "keepAlive": 25
          }
        ],
        "mtu": 1280,
        "domainStrategy": "ForceIPv4"
      },
      "tag": "warp"
    },
    {
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIPv4v6"
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "domainMatcher": "hybrid",
    "rules": [
      {
        "type": "field",
        "inboundTag": ["api"],
        "outboundTag": "api"
      },
      {
        "type": "field",
        "domain": [
          "domain:cloudflare.com",
          "domain:gemini.google.com",
          "domain:generativeai.google",
          "domain:ai.google.com",
          "geosite:google"
        ],
        "outboundTag": "warp"
      },
      {
        "type": "field",
        "protocol": ["bittorrent"],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
    ]
  }
}